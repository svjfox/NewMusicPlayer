<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             mc:Ignorable="d"
             x:Class="MusicPlayerVS.MainPage"
             Title="Music Player">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
        </Style>

        <Style TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardColor}" />
            <Setter Property="BorderColor" Value="{DynamicResource SecondaryColor}" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="HasShadow" Value="True" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="MinimumTrackColor" Value="{DynamicResource SecondaryColor}" />
            <Setter Property="MaximumTrackColor" Value="{DynamicResource SliderTrackColor}" />
            <Setter Property="ThumbColor" Value="{DynamicResource SliderThumbColor}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <toolkit:MediaElement x:Name="MediaPlayer"
                             ShouldShowPlaybackControls="False"
                             ShouldLoopPlayback="False"
                             ShouldKeepScreenOn="True"
                             MediaEnded="MediaPlayer_MediaEnded"
                             MediaFailed="MediaPlayer_MediaFailed"
                             MediaOpened="MediaPlayer_MediaOpened"
                             IsVisible="False" />

        <Grid BackgroundColor="{DynamicResource BackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0" Orientation="Horizontal" HorizontalOptions="End" Padding="10">
                <ImageButton x:Name="PlaylistsButton" 
                            Source="playlist_icon.png" 
                            Clicked="OpenPlaylists_Clicked"
                            HeightRequest="30" 
                            WidthRequest="30"/>

                <ImageButton x:Name="ThemeToggleButton" 
                            Clicked="ToggleTheme_Clicked"
                            BackgroundColor="Transparent"
                            HeightRequest="30"
                            WidthRequest="30"/>
            </StackLayout>

            <Frame x:Name="MainContentFrame" Grid.Row="1" Margin="20" VerticalOptions="Center">
                <StackLayout Spacing="20">
                    <Frame HeightRequest="250" WidthRequest="250" 
                           HorizontalOptions="Center" 
                           Padding="0" 
                           CornerRadius="125"
                           IsClippedToBounds="True">
                        <Image x:Name="AlbumCoverImage" 
                               Source="music_cover.png" 
                               Aspect="AspectFill"/>
                    </Frame>

                    <StackLayout Spacing="5">
                        <Label x:Name="CurrentPlaylistLabel" 
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"
                               FontSize="14"
                               TextColor="{DynamicResource SecondaryColor}"
                               IsVisible="False"/>

                        <Label x:Name="SongTitleLabel" 
                               Text="Press Play to start" 
                               FontSize="22" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" />
                        <Label x:Name="ArtistLabel" 
                               Text="Unknown Artist" 
                               FontSize="16" 
                               HorizontalOptions="Center" />
                    </StackLayout>

                    <StackLayout Spacing="5">
                        <Slider x:Name="PositionSlider"
                                Minimum="0"
                                Maximum="1"
                                Value="0"/>
                        <StackLayout Orientation="Horizontal">
                            <Label x:Name="CurrentTimeLabel" Text="0:00" FontSize="14" />
                            <Label Text=" / " FontSize="14" />
                            <Label x:Name="TotalTimeLabel" Text="0:00" FontSize="14" />
                        </StackLayout>
                    </StackLayout>

                    <StackLayout Spacing="5" Orientation="Horizontal">
                        <Image Source="volume_low.png" HeightRequest="20" />
                        <Slider x:Name="VolumeSlider"
                                Minimum="0" 
                                Maximum="1"
                                Value="0.5"
                                HorizontalOptions="FillAndExpand" />
                        <Image Source="volume_high.png" HeightRequest="20" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <Frame x:Name="ControlsFrame" Grid.Row="2" Margin="20,0,20,20" Padding="15">
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                    <ImageButton x:Name="RepeatButton" 
                               Grid.Column="0" 
                               Source="repeat_icon.png"
                               Clicked="RepeatButton_Clicked"/>

                    <ImageButton x:Name="PrevButton" 
                               Grid.Column="1" 
                               Source="previous_icon.png"
                               Clicked="NextPrevButton_Clicked"/>

                    <Frame x:Name="PlayPauseFrame" 
                         Grid.Column="2" 
                         BackgroundColor="{DynamicResource PrimaryColor}"
                         CornerRadius="35"
                         HeightRequest="70"
                         WidthRequest="70"
                         Padding="0"
                         HorizontalOptions="Center">
                        <Grid>
                            <ImageButton x:Name="PlayButton" 
                                       Source="play_icon_white.png"
                                       Clicked="PlayPauseButton_Clicked"/>
                            <ImageButton x:Name="PauseButton" 
                                       Source="pause_icon_white.png"
                                       IsVisible="False"
                                       Clicked="PlayPauseButton_Clicked"/>
                        </Grid>
                    </Frame>

                    <ImageButton x:Name="NextButton" 
                               Grid.Column="3" 
                               Source="next_icon.png"
                               Clicked="NextPrevButton_Clicked"/>

                    <ImageButton x:Name="FavoriteButton" 
                               Grid.Column="4" 
                               Source="favorite_icon.png"
                               Clicked="FavoriteButton_Clicked"/>
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>