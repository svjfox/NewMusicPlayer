<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicPlayerVS.PlaylistDetailPage"
             Title="{Binding Name}">

    <Grid RowDefinitions="Auto,*">
        <!-- Кнопка Play All и информация о плейлисте -->
        <StackLayout Grid.Row="0" Orientation="Horizontal" HorizontalOptions="Center" Spacing="20" Margin="10">
            <Button Text="Play All"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="50"
                    WidthRequest="150"
                    Clicked="PlayAllClicked"/>

            <Label Text="{Binding Songs.Count, StringFormat='{0} songs'}"
                   VerticalOptions="Center"
                   FontSize="16"/>
        </StackLayout>

        <!-- Список песен -->
        <CollectionView x:Name="SongsCollectionView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="SongSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" CornerRadius="10" BackgroundColor="{DynamicResource CardColor}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Image Source="{Binding CoverImage}" 
                                   HeightRequest="50" WidthRequest="50"
                                   Aspect="AspectFill"/>

                            <StackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding Artist}" FontSize="14" 
                                       TextColor="{DynamicResource SecondaryColor}"/>
                            </StackLayout>

                            <ImageButton Grid.Column="2" Source="play_icon.png"
                                        BackgroundColor="Transparent"
                                        HeightRequest="30" WidthRequest="30"
                                        CommandParameter="{Binding .}"
                                        Clicked="PlaySongClicked"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>