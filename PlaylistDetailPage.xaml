<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicPlayerVS.PlaylistDetailPage"
             Title="{Binding Name}">

    <Grid>
        <CollectionView x:Name="SongsCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="SongSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" CornerRadius="10" BackgroundColor="{DynamicResource CardColor}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                            <Image Source="{Binding CoverImage}" 
                                   HeightRequest="50" WidthRequest="50"
                                   Aspect="AspectFill"/>

                            <StackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding Artist}" FontSize="14" 
                                       TextColor="{DynamicResource SecondaryColor}"/>
                            </StackLayout>

                            <ImageButton Grid.Column="2" Source="play_icon.png"
                                        BackgroundColor="Transparent"
                                        HeightRequest="30" WidthRequest="30"
                                        CommandParameter="{Binding .}"
                                        Clicked="PlaySongClicked"/>
                            <Button Text="Play All" 
                                    Clicked="PlayAllClicked"
                                    HorizontalOptions="Center"
                                    Margin="0,10"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
